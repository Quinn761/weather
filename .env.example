APP_PORT=80
API_PORT=8080
MYSQL_ROOT_PASSWORD=change-me-now
POSTGIS_PASSWORD=weatherhub
POSTGIS_PORT=5432
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
JWT_SECRET=please-change-to-a-random-string-of-at-least-32-chars
JWT_EXPIRE_HOURS=24
SEED_RBAC=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1,https://quinn761.github.io

# DeepSeek（默认）。在 https://platform.deepseek.com/api_keys 创建 Key。
AI_API_KEY=
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat
# 通义：AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1 ，AI_MODEL=qwen-plus
# AI_EMBEDDING_MODEL=

# 前端 AI 圈地（Vite 只暴露 VITE_ 前缀）。密钥不要提交 Git。
VITE_ROBOFLOW_API_KEY=
VITE_ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/666s-workspace-l0hrj/workflows/1789032615331
# Docker / k8s: 生产流水线会以 INSTALL_SAM2=true 构建镜像，并内置 tiny 权重到 /models。
# 本地 Compose 仍可设 INSTALL_SAM2=true，并把权重放到 python-agent/checkpoints/sam2.1_hiera_tiny.pt
INSTALL_SAM2=false
SAM2_CHECKPOINT=
SAM2_CONFIG=configs/sam2.1/sam2.1_hiera_t.yaml
SAM2_DEVICE=cpu
# SAM2_SERVICE_URL=http://python-agent:8000
